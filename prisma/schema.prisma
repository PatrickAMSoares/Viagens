// Meu Roteiro — schema de referência (rascunho para revisão, ainda não migrado)
// Ver docs/03-banco-de-dados.md para a explicação de cada tabela.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum Confianca {
  alta
  media
  baixa
}
enum Role {
  cliente
  admin
}
enum StatusViagem {
  rascunho
  previa_gerada
  pago
  roteiro_gerado
  falhou
}
enum StatusPedido {
  criado
  aguardando_pagamento
  pago
  falhou
  reembolsado
  expirado
}
enum TipoRoteiro {
  previa
  completo
}
enum Estilo {
  economico
  equilibrado
  confortavel
  premium
}
enum Companhia {
  sozinho
  casal
  amigos
  familia
  criancas
  grupo
}
enum Modal {
  a_pe
  onibus
  metro
  app
  taxi
  transfer
  carro
  barco
  bicicleta
}
enum PeriodoDia {
  manha
  almoco
  tarde
  fim_tarde
  noite
}
enum ContextoDica {
  geral
  noite
  praia
  trilha
  transporte
  clima
  golpes
  pertences
}
enum TipoPOI {
  atracao
  restaurante
}

// ─────────────────────────── CATÁLOGO ───────────────────────────

model Destino {
  id             String   @id @default(uuid())
  slug           String   @unique
  nome           String
  estado         String   @db.Char(2)
  pais           String   @default("BR") @db.Char(2)
  descricaoCurta String @map("descricao_curta")
  descricaoLonga String? @map("descricao_longa")
  categorias     String[]
  imagens        Json     @default("[]")
  centroLat      Decimal? @db.Decimal(10, 7) @map("centro_lat")
  centroLng      Decimal? @db.Decimal(10, 7) @map("centro_lng")
  fuso           String   @default("America/Sao_Paulo")
  moeda          String   @default("BRL")
  notasTransito  String? @map("notas_transito")
  climaNotas     String? @map("clima_notas")
  melhorEpoca    Json? @map("melhor_epoca")
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  atracoes       Atracao[]
  restaurantes   Restaurante[]
  transportes    Transporte[]
  dicasSeguranca DicaSeguranca[]
  viagens        Viagem[]

  @@map("destinos")
}

model Atracao {
  id                     String    @id @default(uuid())
  destinoId              String @map("destino_id")
  destino                Destino   @relation(fields: [destinoId], references: [id])
  nome                   String
  slug                   String
  categoria              String    // praia, natureza, trilha, museu, mirante, parque...
  subcategorias          String[]
  descricao              String
  endereco               String?
  bairro                 String?
  lat                    Decimal?  @db.Decimal(10, 7)
  lng                    Decimal?  @db.Decimal(10, 7)
  horarios               Json?     // { seg: [{abre,fecha}], ..., excecoes: [...] }
  precoMin               Decimal?  @db.Decimal(10, 2) @map("preco_min")
  precoMax               Decimal?  @db.Decimal(10, 2) @map("preco_max")
  precoObs               String? @map("preco_obs")
  gratuito               Boolean   @default(false)
  duracaoMin             Int?      // minutos @map("duracao_min")
  duracaoRecomendadaMin  Int? @map("duracao_recomendada_min")
  perfisIndicados        String[] @map("perfis_indicados")
  melhorHorario          PeriodoDia[] @map("melhor_horario")
  adequadoCriancas       Boolean   @default(true) @map("adequado_criancas")
  acessivelPcd           Boolean? @map("acessivel_pcd")
  requerReserva          Boolean   @default(false) @map("requer_reserva")
  indoor                 Boolean   @default(false) // insumo do plano B de chuva
  sazonalidade           String?
  infoSeguranca          String? @map("info_seguranca")
  dicas                  String?
  prioridadeBase         Int       @default(3) // 1..5 @map("prioridade_base")
  fonteUrl               String? @map("fonte_url")
  verificadoEm           DateTime? @map("verificado_em")
  confianca              Confianca @default(media)
  linkAfiliado           String?   // preparado para v2 @map("link_afiliado")
  parceiroId             String? @map("parceiro_id")
  ativo                  Boolean   @default(true)
  criadoEm               DateTime  @default(now()) @map("criado_em")
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em")

  @@unique([destinoId, slug])
  @@index([destinoId, categoria, ativo])
  @@map("atracoes")
}

model Restaurante {
  id               String    @id @default(uuid())
  destinoId        String @map("destino_id")
  destino          Destino   @relation(fields: [destinoId], references: [id])
  nome             String
  slug             String
  categoria        String    // cozinha: italiana, frutos do mar, cafeteria...
  tipos            PeriodoDia[] // café / almoço / jantar / noite
  faixaPreco       Int       // 1..4  ($ .. $$$$) @map("faixa_preco")
  ticketMedio      Decimal?  @db.Decimal(10, 2) @map("ticket_medio")
  bairro           String?
  endereco         String?
  lat              Decimal?  @db.Decimal(10, 7)
  lng              Decimal?  @db.Decimal(10, 7)
  horarios         Json?
  perfisIndicados  String[] @map("perfis_indicados")
  vegetariano      Boolean   @default(false)
  adequadoCriancas Boolean   @default(true) @map("adequado_criancas")
  requerReserva    Boolean   @default(false) @map("requer_reserva")
  dicas            String?
  fonteUrl         String? @map("fonte_url")
  verificadoEm     DateTime? @map("verificado_em")
  confianca        Confianca @default(media)
  ativo            Boolean   @default(true)

  @@unique([destinoId, slug])
  @@index([destinoId, faixaPreco, ativo])
  @@map("restaurantes")
}

model Transporte {
  id              String    @id @default(uuid())
  destinoId       String @map("destino_id")
  destino         Destino   @relation(fields: [destinoId], references: [id])
  modal           Modal
  regiao          String?
  nomeLinha       String? @map("nome_linha")
  descricao       String
  custoAprox      Decimal?  @db.Decimal(10, 2) @map("custo_aprox")
  comoPagar       String? @map("como_pagar")
  horariosOperacao String? @map("horarios_operacao")
  observacoes     String?
  fonteUrl        String? @map("fonte_url")
  verificadoEm    DateTime? @map("verificado_em")
  confianca       Confianca @default(media)

  @@index([destinoId, modal])
  @@map("transportes")
}

model DicaSeguranca {
  id           String        @id @default(uuid())
  destinoId    String @map("destino_id")
  destino      Destino       @relation(fields: [destinoId], references: [id])
  contexto     ContextoDica
  regiao       String?
  texto        String
  severidade   String        @default("info") // info | atencao
  fonteUrl     String? @map("fonte_url")
  verificadoEm DateTime? @map("verificado_em")

  @@index([destinoId, contexto])
  @@map("dicas_seguranca")
}

/// Matriz de deslocamentos pré-computada (Google Routes API), por par de POIs e modal.
model PoiDistancia {
  id           String   @id @default(uuid())
  origemTipo   TipoPOI @map("origem_tipo")
  origemId     String @map("origem_id")
  destinoTipo  TipoPOI @map("destino_tipo")
  destinoId    String @map("destino_id")
  modal        Modal
  minutos      Int
  km           Decimal  @db.Decimal(8, 2)
  custoAprox   Decimal? @db.Decimal(10, 2) @map("custo_aprox")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([origemId, destinoId, modal])
  @@index([origemId, modal])
  @@map("poi_distancias")
}

// ─────────────────────────── USUÁRIOS E VIAGENS ───────────────────────────

model Usuario {
  id             String    @id @default(uuid())
  email          String    @unique
  nome           String?
  telefone       String?
  role           Role      @default(cliente)
  preferencias   Json      @default("{}")
  aceiteTermosEm DateTime? @map("aceite_termos_em")
  aceiteMarketing Boolean  @default(false) @map("aceite_marketing")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  excluidoEm     DateTime? @map("excluido_em")

  viagens Viagem[]
  pedidos Pedido[]

  @@map("usuarios")
}

model Viagem {
  id               String       @id @default(uuid())
  usuarioId        String? @map("usuario_id")
  usuario          Usuario?     @relation(fields: [usuarioId], references: [id])
  destinoId        String @map("destino_id")
  destino          Destino      @relation(fields: [destinoId], references: [id])
  status           StatusViagem @default(rascunho)

  dias             Int
  dataInicio       DateTime? @map("data_inicio")
  dataFim          DateTime? @map("data_fim")
  companhia        Companhia
  adultos          Int          @default(1)
  criancas         Int          @default(0)
  idadesCriancas   Int[] @map("idades_criancas")
  estilo           Estilo
  orcamentoPessoa  Decimal?     @db.Decimal(10, 2) @map("orcamento_pessoa")
  perfil           String[]
  interesses       String[]
  transportes      String[]
  desejosTexto     String? @map("desejos_texto")
  desejosParseados Json? @map("desejos_parseados")
  respostasRaw     Json         @default("{}") @map("respostas_raw")

  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @updatedAt @map("atualizado_em")

  roteiros Roteiro[]
  pedidos  Pedido[]

  @@index([status, criadoEm])
  @@map("viagens")
}

model Roteiro {
  id            String      @id @default(uuid())
  viagemId      String @map("viagem_id")
  viagem        Viagem      @relation(fields: [viagemId], references: [id])
  pedidoId      String? @map("pedido_id")
  pedido        Pedido?     @relation(fields: [pedidoId], references: [id])
  produtoId     String? @map("produto_id")
  produto       Produto?    @relation(fields: [produtoId], references: [id])
  tipo          TipoRoteiro
  versao        Int         @default(1)
  conteudo      Json        // RoteiroJSON validado — ver docs/07-motor-de-ia.md
  modeloIa      String? @map("modelo_ia")
  tokensEntrada Int? @map("tokens_entrada")
  tokensSaida   Int? @map("tokens_saida")
  custoUsd      Decimal?    @db.Decimal(10, 5) @map("custo_usd")
  duracaoMs     Int? @map("duracao_ms")
  pdfUrl        String? @map("pdf_url")
  pdfGeradoEm   DateTime? @map("pdf_gerado_em")
  criadoEm      DateTime    @default(now()) @map("criado_em")

  @@unique([viagemId, tipo, versao])
  @@map("roteiros")
}

// ─────────────────────────── COMERCIAL ───────────────────────────

model Produto {
  id                  String   @id @default(uuid())
  slug                String   @unique // essencial | completo | premium
  nome                String
  descricao           String?
  beneficios          Json     @default("[]")
  precoCentavos       Int @map("preco_centavos")
  precoRiscadoCentavos Int? @map("preco_riscado_centavos")
  moeda               String   @default("BRL")
  secoesIncluidas     String[] // transporte, orcamento, seguranca, plano_b, ... @map("secoes_incluidas")
  destaque            Boolean  @default(false)
  ordem               Int      @default(0)
  ativo               Boolean  @default(true)
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  pedidos  Pedido[]
  roteiros Roteiro[]

  @@map("produtos")
}

model Pedido {
  id                String       @id @default(uuid())
  usuarioId         String @map("usuario_id")
  usuario           Usuario      @relation(fields: [usuarioId], references: [id])
  viagemId          String @map("viagem_id")
  viagem            Viagem       @relation(fields: [viagemId], references: [id])
  produtoId         String @map("produto_id")
  produto           Produto      @relation(fields: [produtoId], references: [id])
  valorCentavos     Int @map("valor_centavos")
  descontoCentavos  Int          @default(0) @map("desconto_centavos")
  status            StatusPedido @default(criado)
  gateway           String       @default("mercadopago")
  gatewayPedidoId   String? @map("gateway_pedido_id")
  gatewayPagamentoId String? @map("gateway_pagamento_id")
  metodo            String?      // pix | cartao
  pagoEm            DateTime? @map("pago_em")
  expiraEm          DateTime? @map("expira_em")
  criadoEm          DateTime     @default(now()) @map("criado_em")

  pagamentos Pagamento[]
  roteiros   Roteiro[]

  @@index([status, criadoEm])
  @@map("pedidos")
}

/// Log imutável de eventos do gateway. Garante idempotência do webhook.
model Pagamento {
  id               String   @id @default(uuid())
  pedidoId         String @map("pedido_id")
  pedido           Pedido   @relation(fields: [pedidoId], references: [id])
  gateway          String   @default("mercadopago")
  eventoId         String @map("evento_id")
  evento           String
  status           String
  valorCentavos    Int? @map("valor_centavos")
  payload          Json
  assinaturaValida Boolean  @default(false) @map("assinatura_valida")
  recebidoEm       DateTime @default(now()) @map("recebido_em")
  processadoEm     DateTime? @map("processado_em")

  @@unique([gateway, eventoId])
  @@map("pagamentos")
}

/// Trilha de auditoria de dados factuais (preço, horário, endereço...).
model FonteVerificacao {
  id            String   @id @default(uuid())
  entidade      String   // atracao | restaurante | transporte | dica
  entidadeId    String @map("entidade_id")
  campo         String
  valorAnterior String? @map("valor_anterior")
  valorNovo     String? @map("valor_novo")
  fonteUrl      String? @map("fonte_url")
  verificadoPor String? @map("verificado_por")
  verificadoEm  DateTime @default(now()) @map("verificado_em")

  @@index([entidade, entidadeId])
  @@map("fontes_verificacao")
}
